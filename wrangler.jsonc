{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nhtsa-edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "UPSTREAM_TIMEOUT_MS": "5000",
    "ENABLE_KV_CACHE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nhtsa-db",
      "database_id": "43924716-1f92-4d2b-a316-c77435f3d455",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
  /**
   * Optional: Uncomment to enable persistent global KV caching across all edge PoPs
   * Run: npx wrangler kv:namespace create NHTSA_CACHE_KV
   * and paste the id below:
   *
   * "kv_namespaces": [
   *   {
   *     "binding": "NHTSA_CACHE_KV",
   *     "id": "<YOUR_KV_NAMESPACE_ID>"
   *   }
   * ]
   */
}
