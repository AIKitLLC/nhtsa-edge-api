{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nhtsa-edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Offline decoder data, built from data/vpic by `pnpm build:data`.
  // run_worker_first keeps the raw files private: they are read only through env.ASSETS.
  "assets": {
    "directory": "./build/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Production is served at data.ai-kit.net. The zone must be on the same Cloudflare
  // account: wrangler creates the DNS record and the certificate on deploy.
  // env.dev must override routes (below): it inherits them otherwise, and deploying dev
  // would take the domain away from production.
  "routes": [{ "pattern": "data.ai-kit.net", "custom_domain": true }],
  // Configuring routes makes wrangler turn workers.dev off unless it is set explicitly, which
  // would silently take down the original nhtsa-edge-api.<account>.workers.dev URL.
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "UPSTREAM_TIMEOUT_MS": "5000",
    "ENABLE_KV_CACHE": "false"
  },
  "env": {
    // Deployed by .github/workflows/vpic-data.yml after each verified data/decoder change
    "dev": {
      "name": "nhtsa-edge-api-dev",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./build/assets",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "ENVIRONMENT": "dev",
        "UPSTREAM_TIMEOUT_MS": "5000",
        "ENABLE_KV_CACHE": "false"
      }
    }
  }
  /**
   * Optional: persistent KV cache for the proxied (non-decode) endpoints.
   * Run: npx wrangler kv namespace create NHTSA_CACHE_KV
   * then add under the top level (and/or env.dev):
   *
   * "kv_namespaces": [{ "binding": "NHTSA_CACHE_KV", "id": "<YOUR_KV_NAMESPACE_ID>" }]
   * and set "ENABLE_KV_CACHE": "true".
   */
}
